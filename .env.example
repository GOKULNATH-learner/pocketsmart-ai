# PocketSmart AI Environment Configuration
# Copy this file to .env and configure your variables

# Google Gemini AI Key (Optional - Fallback engine works automatically if not provided)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model Name (e.g. gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Application Secret Key for JWT Session Tokens
SECRET_KEY=pocketsmart_ai_super_secret_jwt_key_2026_change_in_production

# Environment Mode
ENVIRONMENT=development
DEBUG=True
PORT=8000
